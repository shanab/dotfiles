#!/usr/bin/env bash
# herdr-pick: fuzzy-pick a workspace:tab across the local herdr server and every saved
# machine it can reach, then focus it. Bound to prefix+f as a herdr popup
# ([[keys.command]] in config.toml). Lives in the dotfiles herdr/ dir, stowed to ~/.config/herdr/.
#
# Needs: herdr, fzf, python3. The popup does not run a login shell, so PATH is set here.
# Debug: HERDR_PICK_DEBUG=1 (or touch ~/.config/herdr/herdr-pick.debug) logs to ~/.config/herdr/herdr-pick.log

set -uo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.toolbox/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
herdr_bin="${HERDR_BIN_PATH:-herdr}"
log="$HOME/.config/herdr/herdr-pick.log"
debug=0; { [ "${HERDR_PICK_DEBUG:-0}" = 1 ] || [ -e "$HOME/.config/herdr/herdr-pick.debug" ]; } && debug=1
dbg() { [ "$debug" = 1 ] && printf '%s %s\n' "$(date +%T)" "$*" >> "$log"; return 0; }

for dep in fzf python3; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "herdr-pick: $dep not found on PATH ($PATH)" >&2; dbg "missing $dep"; sleep 2; exit 1
  fi
done
dbg "start PATH=$PATH TERM=${TERM:-} herdr=$herdr_bin"

# Print one line per tab: <machine>\t<tab_id>\t<mark> <workspace>:<tab>
collect() {
  local machine="$1" tag="$2" out
  local -a h=("$herdr_bin"); [ -n "$machine" ] && h+=(--machine "$machine")
  local ws tabs
  ws=$("${h[@]}" workspace list 2>>"$log") || { dbg "workspace list failed for '${tag}'"; return 0; }
  tabs=$("${h[@]}" tab list 2>>"$log")      || { dbg "tab list failed for '${tag}'"; return 0; }
  printf '%s\n---\n%s\n' "$ws" "$tabs" | python3 -c '
import sys, json
tag = sys.argv[1]
raw = sys.stdin.read().split("\n---\n", 1)
try:
    ws = {w["workspace_id"]: w["label"] for w in json.loads(raw[0])["result"]["workspaces"]}
    tabs = json.loads(raw[1])["result"]["tabs"]
except Exception as e:
    print(f"herdr-pick: parse error for {tag}: {e}", file=sys.stderr); sys.exit(0)
marks = {"working": "*", "blocked": "!"}
for t in tabs:
    label = ws.get(t["workspace_id"], t["workspace_id"])
    mark = marks.get(t.get("agent_status", ""), " ")
    print(f"{tag}\t{t[\"tab_id\"]}\t{mark} {label}:{t[\"label\"]}")
' "$tag"
}

local_tag="$(hostname -s 2>/dev/null || echo local)"
case "$local_tag" in dev-dsk-*) local_tag="cdd" ;; esac

lines=$(collect "" "$local_tag")
while IFS=$'\t' read -r _id label _target _session enabled _rest; do
  [ -z "${label:-}" ] && continue
  [ "${enabled:-}" = "enabled" ] || continue
  lines+=$'\n'"$(collect "$label" "$label")"
done < <("$herdr_bin" machine list 2>>"$log")
dbg "collected $(printf '%s\n' "$lines" | grep -c .) lines"

choice=$(printf '%s\n' "$lines" | grep . | fzf \
  --delimiter=$'\t' --with-nth=1,3 --height=100% --reverse \
  --prompt='workspace:tab > ' --header='* working  ! blocked   enter: focus   esc: cancel' \
  --bind 'esc:abort')
rc=$?
[ $rc -ne 0 ] || [ -z "$choice" ] && { dbg "cancelled rc=$rc"; exit 0; }

machine=$(printf '%s' "$choice" | cut -f1)
tab_id=$(printf '%s' "$choice" | cut -f2)
dbg "focus machine=$machine tab=$tab_id"
if [ "$machine" = "$local_tag" ]; then "$herdr_bin" tab focus "$tab_id" >/dev/null 2>>"$log"
else "$herdr_bin" --machine "$machine" tab focus "$tab_id" >/dev/null 2>>"$log"; fi
