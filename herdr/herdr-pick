#!/usr/bin/env bash
# herdr-pick: fuzzy-pick a workspace:tab across all connected machines and focus it.
# Bound to prefix+f as a herdr popup ([[keys.command]] in config.toml).
# Needs: herdr, fzf, python3. Lives in the dotfiles herdr/ dir, stowed to ~/.config/herdr/.
set -euo pipefail

herdr_bin="${HERDR_BIN_PATH:-herdr}"

# Lines: <machine>\t<tab_id>\t<workspace>:<tab>  [agent status]
collect() {
  local machine="$1" prefix=() tag="local"
  if [ -n "$machine" ]; then prefix=(--machine "$machine"); tag="$machine"; fi
  "$herdr_bin" "${prefix[@]}" tab list 2>/dev/null | python3 -c '
import sys, json
tag = sys.argv[1]
try:
    tabs = json.load(sys.stdin)["result"]["tabs"]
except Exception:
    sys.exit(0)
ws_json = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
for t in tabs:
    ws = ws_json.get(t["workspace_id"], t["workspace_id"])
    status = t.get("agent_status", "")
    mark = {"working": "*", "blocked": "!", "idle": " "}.get(status, " ")
    print(f"{tag}\t{t['tab_id']}\t{mark} {ws}:{t['label']}")
' "$tag" "$("$herdr_bin" "${prefix[@]}" workspace list 2>/dev/null | python3 -c 'import sys,json
try: print(json.dumps({w["workspace_id"]: w["label"] for w in json.load(sys.stdin)["result"]["workspaces"]}))
except Exception: print("{}")')"
}

machines=$("$herdr_bin" machine list 2>/dev/null | awk -F'\t' '$5=="enabled"{print $3}')

{
  collect ""
  for m in $machines; do collect "$m"; done
} | fzf --delimiter='\t' --with-nth=1,3 --nth=1,3 --prompt='workspace:tab > ' --height=100% --reverse \
      --header='* working  ! blocked   (enter = focus)' | {
  IFS=$'\t' read -r machine tab_id _ || exit 0
  if [ "$machine" = "local" ]; then "$herdr_bin" tab focus "$tab_id" >/dev/null
  else "$herdr_bin" --machine "$machine" tab focus "$tab_id" >/dev/null; fi
}
