#!/usr/bin/env bash
# herdr-pick: fuzzy-pick a workspace:tab across the local herdr server and every saved
# machine it can reach, then focus it. Bound to prefix+f as a herdr popup
# ([[keys.command]] in config.toml). Lives in the dotfiles herdr/ dir, stowed to ~/.config/herdr/.
#
# fzf opens at once with local tabs; remote machines (5-6s each over ssh) stream in as they
# answer, in parallel, each capped at HERDR_PICK_TIMEOUT seconds (default 15).
#
# Usage:
#   herdr-pick           interactive picker (what the popup runs)
#   herdr-pick --list    print the candidate lines and exit (for tests)
#
# Needs: herdr, fzf, python3. The popup does not run a login shell, so PATH is set here.
# Debug: HERDR_PICK_DEBUG=1 (or touch ~/.config/herdr/herdr-pick.debug) logs to ~/.config/herdr/herdr-pick.log

set -uo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.toolbox/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
herdr_bin="${HERDR_BIN_PATH:-herdr}"
remote_timeout="${HERDR_PICK_TIMEOUT:-15}"
log="$HOME/.config/herdr/herdr-pick.log"
debug=0; { [ "${HERDR_PICK_DEBUG:-0}" = 1 ] || [ -e "$HOME/.config/herdr/herdr-pick.debug" ]; } && debug=1
dbg() { [ "$debug" = 1 ] && printf '%s [%s] %s\n' "$(date +%T)" "$$" "$*" >> "$log"; return 0; }
errlog="/dev/null"; [ "$debug" = 1 ] && errlog="$log"

die() { echo "herdr-pick: $*" >&2; dbg "fatal: $*"; sleep 3; exit 1; }
for dep in fzf python3 "$herdr_bin"; do
  command -v "$dep" >/dev/null 2>&1 || die "$dep not found on PATH ($PATH)"
done
tmo=""; for t in timeout gtimeout; do command -v "$t" >/dev/null 2>&1 && { tmo="$t"; break; }; done

# Run a herdr API command with no stdin (ssh must never read the popup TTY), optional timeout.
hrun() {
  local secs="$1"; shift
  if [ -n "$tmo" ] && [ "$secs" -gt 0 ]; then "$tmo" "$secs" "$herdr_bin" "$@" </dev/null 2>>"$errlog"
  else "$herdr_bin" "$@" </dev/null 2>>"$errlog"; fi
}

# Print one line per tab: <machine>\t<tab_id>\t<mark> <workspace>:<tab>
collect() {
  local machine="$1" tag="$2" secs="$3" ws tabs
  local -a m=(); [ -n "$machine" ] && m=(--machine "$machine")
  local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-pick.XXXXXX")
  hrun "$secs" "${m[@]}" workspace list >"$tmp/ws" & local p1=$!
  hrun "$secs" "${m[@]}" tab list >"$tmp/tabs" & local p2=$!
  wait $p1 || { dbg "workspace list failed/timed out for $tag"; rm -rf "$tmp"; return 0; }
  wait $p2 || { dbg "tab list failed/timed out for $tag"; rm -rf "$tmp"; return 0; }
  ws=$(<"$tmp/ws"); tabs=$(<"$tmp/tabs"); rm -rf "$tmp"
  WS="$ws" TABS="$tabs" python3 - "$tag" <<'PY'
import json, os, sys
tag = sys.argv[1]
try:
    ws = {w["workspace_id"]: w["label"] for w in json.loads(os.environ["WS"])["result"]["workspaces"]}
    tabs = json.loads(os.environ["TABS"])["result"]["tabs"]
except Exception as e:
    print(f"herdr-pick: parse error for {tag}: {e}", file=sys.stderr)
    sys.exit(0)
marks = {"working": "*", "blocked": "!"}
for t in tabs:
    label = ws.get(t["workspace_id"], t["workspace_id"])
    mark = marks.get(t.get("agent_status", ""), " ")
    print(f'{tag}\t{t["tab_id"]}\t{mark} {label}:{t["label"]}', flush=True)
PY
}

case "$(uname -s)" in Darwin) local_tag="mac" ;; *) local_tag="$(hostname -s 2>/dev/null || echo local)" ;; esac
case "$local_tag" in dev-dsk-*) local_tag="cdd" ;; esac

# Local first, then every enabled saved machine in parallel. Streams to stdout.
produce() {
  collect "" "$local_tag" 0
  local pids=() label enabled
  while IFS=$'\t' read -r _id label _target _session enabled _rest; do
    [ -n "${label:-}" ] && [ "${enabled:-}" = "enabled" ] || continue
    collect "$label" "$label" "$remote_timeout" & pids+=($!)
  done < <(hrun 5 machine list)
  [ ${#pids[@]} -gt 0 ] && wait "${pids[@]}"
  dbg "produce done (${#pids[@]} remote)"
}

if [ "${1:-}" = "--list" ]; then produce; exit 0; fi

dbg "start TERM=${TERM:-} tty=$(tty 2>/dev/null) herdr=$(command -v "$herdr_bin") timeout=${tmo:-none}"
# Process substitution (not a pipe) so esc/enter returns at once instead of waiting for slow remotes.
exec 3< <(produce); prod_pid=$!
choice=$(fzf <&3 \
  --delimiter=$'\t' --with-nth=1,3 --height=100% --reverse \
  --prompt='workspace:tab > ' --header='* working  ! blocked   enter: focus   esc: cancel   (remote machines load in a few seconds)' \
  --bind 'esc:abort')
rc=$?
exec 3<&-
pkill -P "$prod_pid" 2>/dev/null; kill "$prod_pid" 2>/dev/null
dbg "fzf rc=$rc choice=${choice//$'\t'/ | }"
{ [ $rc -ne 0 ] || [ -z "$choice" ]; } && exit 0

machine=$(printf '%s' "$choice" | cut -f1)
tab_id=$(printf '%s' "$choice" | cut -f2)
if [ "$machine" = "$local_tag" ]; then hrun 0 tab focus "$tab_id" >/dev/null
else hrun "$remote_timeout" --machine "$machine" tab focus "$tab_id" >/dev/null; fi
dbg "focus machine=$machine tab=$tab_id rc=$?"
