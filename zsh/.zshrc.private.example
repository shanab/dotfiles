# Private/Work-specific zsh configuration
# Copy this file to ~/.config/zsh/.zshrc.private and customize for your work environment.
# Anything matching *.private is gitignored. Available hooks:
#   .zshrc.pre.private     sourced at the top of .zshrc
#   .zshrc.private         sourced at the bottom of .zshrc (this file)
#   .zprofile.pre.private  sourced at the top of .zprofile
#   .zprofile.private      sourced at the bottom of .zprofile
# This file should NOT be committed to your dotfiles repository

# Work-specific aliases
# alias deploy-prod="kubectl apply -f prod-deployment.yaml"
# alias vpn-connect="sudo openconnect --background vpn.company.com"
# alias work-logs="tail -f /var/log/work-app.log"
# alias company-ssh="ssh user@work-server.company.com"

